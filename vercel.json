    "api/transcribe.js":  { "maxDuration": 120 },
    "api/ai-score.js":    { "maxDuration": 120 },
    "api/upload.js":      { "maxDuration": 30  },
    "api/smartflo-sync.js": { "maxDuration": 60 },
    "api/refresh-stakeholder-dashboards.js": { "maxDuration": 60 },
    "api/notify-agent.js": { "maxDuration": 30 },
